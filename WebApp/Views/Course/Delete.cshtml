@model WebApp.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<h1>Delete Course</h1>

<h3>Are you sure you want to delete this course?</h3>

<div>
    <dl class="row">

        <dt class="col-sm-2">Course ID</dt>
        <dd class="col-sm-10">@Model.CourseID</dd>

        <dt class="col-sm-2">Course Number</dt>
        <dd class="col-sm-10">@Model.CourseNumber</dd>

        <dt class="col-sm-2">Course Name</dt>
        <dd class="col-sm-10">@Model.CourseName</dd>

        <dt class="col-sm-2">Semester</dt>
        <dd class="col-sm-10">
            @Model.Semester.SemesterName (@Model.Semester.Year)
        </dd>

    </dl>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="CourseID" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>
