@using Microsoft.EntityFrameworkCore
@using WebApp.Data
@inject ApplicationDbContext Context

@{
    ViewData["Title"] = ViewData["Title"];

    var studentName = "there";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userId = User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        var student = await Context.Students
            .FirstOrDefaultAsync(s => s.ApplicationUserId == userId);

        if (student != null)
        {
            studentName = $"{student.FirstName} {student.LastName}";
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Student Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark portal-navbar shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    Student Portal
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Enrollment"
                                       asp-action="Create">
                                        Available Courses
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Enrollment"
                                       asp-action="Index">
                                        My Enrollments
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Student"
                                       asp-action="Index">
                                        Students
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Course"
                                       asp-action="Index">
                                        Courses
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Enrollment"
                                       asp-action="AdminIndex">
                                        Enrollment Requests
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-light">
                                    Hello, @studentName!
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      method="post">
                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm ms-lg-2 mt-1">
                                        Log Out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm text-white ms-lg-2 mt-1"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    Sign In
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm text-white ms-lg-2 mt-1"
                                   asp-area="Identity"
                                   asp-page="/Account/Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="portal-footer mt-5 py-3">
        <div class="container text-center">
            <span>&copy; @DateTime.Now.Year Student Course Registration System</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

