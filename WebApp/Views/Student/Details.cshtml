@model WebApp.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2 detail-label">Student ID</dt>
        <dd class="col-sm-10">@Model.StudentID</dd>

        <dt class="col-sm-2 detail-label">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2 detail-label">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2 detail-label">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2 detail-label">Username</dt>
        <dd class="col-sm-10">@Model.UserName</dd>
    </dl>
</div>

<div class="mt-4 mb-3">
    <a asp-controller="Student"
       asp-action="CurrentCourses"
       asp-route-id="@Model.StudentID"
       class="btn btn-primary me-2 mb-2">
        Currently Enrolled Courses
    </a>
</div>
<div class="mt-4 mb-3">
    <a asp-controller="CompletedCourse"
       asp-action="Index"
       asp-route-studentId="@Model.StudentID"
       class="btn btn-success mb-2">
        Completed Courses
    </a>
</div>
<a asp-action="Index" class="btn btn-secondary mb-2">
    Back to List
</a>