@model IEnumerable<WebApp.Models.Enrollment>

@{
    ViewData["Title"] = "Currently Enrolled Courses";

    var student = ViewBag.Student as WebApp.Models.Student;
}

<h2>Currently Enrolled Courses</h2>

@if (student != null)
{
    <h5>@student.FirstName @student.LastName</h5>
}

<hr />

@if (!Model.Any())
{
    <div class="alert alert-info">
        No currently enrolled courses were found.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Course ID</th>
                <th>Course Number</th>
                <th>Course Name</th>
                <th>Semester</th>
                <th>Year</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var enrollment in Model)
            {
                <tr>
                    <td>@enrollment.Course.CourseID</td>
                    <td>@enrollment.Course.CourseNumber</td>
                    <td>@enrollment.Course.CourseName</td>
                    <td>@enrollment.Course.Semester.SemesterName</td>
                    <td>@enrollment.Course.Semester.Year</td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Details"
   asp-route-id="@student?.StudentID"
   class="btn btn-secondary">
    Back to Student Details
</a>


