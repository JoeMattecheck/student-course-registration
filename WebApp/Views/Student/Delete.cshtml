@model WebApp.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<h1>Delete Student</h1>

<h3>Are you sure you want to delete this student?</h3>

<div>
    <dl class="row">

        <dt class="col-sm-2">Student ID</dt>
        <dd class="col-sm-10">@Model.StudentID</dd>

        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>

        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.UserName</dd>

    </dl>

    <form asp-action="Delete" method="post"
          onsubmit="return confirm('Unable to delete Student due to associated records.');">

        <input type="hidden" asp-for="StudentID" />

        <input type="submit" value="Delete" class="btn btn-danger" />

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
